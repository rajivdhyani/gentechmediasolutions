---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Contact"
	description="Get in touch with Gentech Media Solutions about IT, media, or management support for your company."
>
	<section class="mx-auto max-w-4xl px-6 py-20">
		<p class="text-xs font-semibold tracking-wide text-amber-500 uppercase">Contact</p>
		<h1 class="mt-2 font-display text-4xl font-semibold text-navy-950">Let's talk about your project</h1>
		<p class="mt-4 max-w-xl text-navy-700/80">
			Tell us what you're working on and where you need help — IT, media, management, or some mix of the three.
			We'll reply by email.
		</p>

		<div class="mt-12 grid gap-10 md:grid-cols-[3fr_2fr]">
			<form
				action="https://formsubmit.co/hr@gentechmediasolutions.com"
				method="POST"
				class="space-y-5 rounded-2xl border border-navy-900/10 bg-white p-8"
			>
				<input type="hidden" name="_subject" value="New inquiry from gentechmediasolutions.com" />
				<input type="hidden" name="_captcha" value="true" />
				<input type="hidden" name="_next" value="https://gentechmediasolutions.com/contact?sent=true" />
				<input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" />

				<div class="grid gap-5 sm:grid-cols-2">
					<div>
						<label for="name" class="text-sm font-medium text-navy-800">Name</label>
						<input
							id="name"
							name="name"
							type="text"
							required
							class="mt-1.5 w-full rounded-lg border border-navy-900/15 px-3.5 py-2.5 text-sm text-navy-950 outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500"
						/>
					</div>
					<div>
						<label for="email" class="text-sm font-medium text-navy-800">Email</label>
						<input
							id="email"
							name="email"
							type="email"
							required
							class="mt-1.5 w-full rounded-lg border border-navy-900/15 px-3.5 py-2.5 text-sm text-navy-950 outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500"
						/>
					</div>
				</div>

				<div>
					<label for="topic" class="text-sm font-medium text-navy-800">What do you need help with?</label>
					<select
						id="topic"
						name="topic"
						class="mt-1.5 w-full rounded-lg border border-navy-900/15 bg-white px-3.5 py-2.5 text-sm text-navy-950 outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500"
					>
						<option>IT Solutions</option>
						<option>Media Solutions</option>
						<option>Management Solutions</option>
						<option>Not sure yet</option>
					</select>
				</div>

				<div>
					<label for="message" class="text-sm font-medium text-navy-800">Message</label>
					<textarea
						id="message"
						name="message"
						rows="5"
						required
						class="mt-1.5 w-full rounded-lg border border-navy-900/15 px-3.5 py-2.5 text-sm text-navy-950 outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500"
					></textarea>
				</div>

				<button
					type="submit"
					class="w-full rounded-full bg-navy-950 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-amber-500 hover:text-navy-950"
				>
					Send message
				</button>
			</form>

			<div class="space-y-6">
				<div class="rounded-2xl bg-mist-100 p-6">
					<p class="text-sm font-semibold text-navy-950">Email</p>
					<a href="mailto:hr@gentechmediasolutions.com" class="mt-1 block text-sm text-navy-700/80 hover:text-amber-500">
						hr@gentechmediasolutions.com
					</a>
				</div>
				<div class="rounded-2xl bg-mist-100 p-6">
					<p class="text-sm font-semibold text-navy-950">Response time</p>
					<p class="mt-1 text-sm text-navy-700/80">We typically reply within one to two business days.</p>
				</div>
			</div>
		</div>
	</section>
</Layout>
