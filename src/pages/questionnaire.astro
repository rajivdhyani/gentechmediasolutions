---
import Layout from '../layouts/Layout.astro';
import { QUESTION_SETS } from '../data/questionnaire.js';
---

<Layout
	title="Tell us more"
	description="A quick questionnaire to help Gentech Media Solutions understand your project."
>
	<section class="mx-auto max-w-2xl px-6 py-20">
		<div id="q-intro">
			<p class="text-xs font-semibold tracking-wide text-amber-500 uppercase">Tell us more</p>
			<h1 class="mt-2 font-display text-3xl font-semibold text-navy-950">
				A few quick questions
			</h1>
			<p class="mt-3 text-navy-700/80">
				This takes about two minutes and helps us understand your project before we reply. Skip
				it any time — we'll still have your message.
			</p>
		</div>

		<div id="q-app" class="mt-10 hidden">
			<div class="h-1.5 w-full overflow-hidden rounded-full bg-navy-900/10">
				<div id="q-progress" class="h-full rounded-full bg-amber-500 transition-all" style="width: 0%"></div>
			</div>
			<p id="q-step-label" class="mt-2 text-xs font-medium text-navy-700/60"></p>

			<form id="q-form" class="mt-8 rounded-2xl border border-navy-900/10 bg-white p-8">
				<h2 id="q-question" class="font-display text-xl font-semibold text-navy-950"></h2>
				<div id="q-options" class="mt-6 space-y-3"></div>

				<div class="mt-8 flex items-center justify-between">
					<button
						type="button"
						id="q-back"
						class="text-sm font-medium text-navy-700/70 hover:text-navy-950 disabled:opacity-0"
					>
						Back
					</button>
					<div class="flex gap-3">
						<a
							href="/"
							class="rounded-full px-5 py-2.5 text-sm font-medium text-navy-700/70 hover:text-navy-950"
						>
							Skip for now
						</a>
						<button
							type="submit"
							id="q-next"
							class="rounded-full bg-navy-950 px-6 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-amber-500 hover:text-navy-950"
						>
							Next
						</button>
					</div>
				</div>
			</form>
		</div>

		<div id="q-done" class="mt-10 hidden rounded-2xl border border-navy-900/10 bg-white p-8 text-center">
			<h2 class="font-display text-xl font-semibold text-navy-950">Thanks — that's really helpful.</h2>
			<p class="mt-2 text-sm text-navy-700/80">We'll follow up by email once we've had a look.</p>
			<a
				href="/"
				class="mt-6 inline-block rounded-full bg-navy-950 px-6 py-2.5 text-sm font-semibold text-white hover:bg-amber-500 hover:text-navy-950"
			>
				Back to home
			</a>
		</div>

		<div id="q-error" class="mt-6 hidden rounded-xl bg-red-50 p-4 text-sm text-red-700"></div>
	</section>

	<script type="application/json" id="question-data" set:html={JSON.stringify(QUESTION_SETS)} />

	<script>
		const questionSets = JSON.parse(document.getElementById('question-data').textContent);

		const params = new URLSearchParams(location.search);
		const contactId = params.get('contact');
		const sectionParam = params.get('section');
		const section = questionSets[sectionParam] ? sectionParam : 'general';
		const questions = questionSets[section].questions;

		const answers = {};
		let step = 0;

		const introEl = document.getElementById('q-intro');
		const appEl = document.getElementById('q-app');
		const doneEl = document.getElementById('q-done');
		const errorEl = document.getElementById('q-error');
		const progressEl = document.getElementById('q-progress');
		const stepLabelEl = document.getElementById('q-step-label');
		const questionEl = document.getElementById('q-question');
		const optionsEl = document.getElementById('q-options');
		const backBtn = document.getElementById('q-back');
		const nextBtn = document.getElementById('q-next');
		const form = document.getElementById('q-form');

		function renderStep() {
			const q = questions[step];
			stepLabelEl.textContent = `Question ${step + 1} of ${questions.length}`;
			progressEl.style.width = `${((step + 1) / questions.length) * 100}%`;
			questionEl.textContent = q.label;
			backBtn.disabled = step === 0;
			nextBtn.textContent = step === questions.length - 1 ? 'Submit' : 'Next';

			optionsEl.innerHTML = '';

			if (q.type === 'text') {
				const textarea = document.createElement('textarea');
				textarea.rows = 4;
				textarea.className =
					'w-full rounded-lg border border-navy-900/15 px-3.5 py-2.5 text-sm text-navy-950 outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500';
				textarea.value = answers[q.key] ?? '';
				textarea.addEventListener('input', () => {
					answers[q.key] = textarea.value;
				});
				optionsEl.appendChild(textarea);
				return;
			}

			const inputType = q.type === 'multi' ? 'checkbox' : 'radio';
			const selected = new Set(
				q.type === 'multi' ? answers[q.key] ?? [] : answers[q.key] ? [answers[q.key]] : []
			);

			q.options.forEach((option, i) => {
				const id = `q-opt-${step}-${i}`;
				const label = document.createElement('label');
				label.htmlFor = id;
				label.className =
					'flex cursor-pointer items-center gap-3 rounded-lg border border-navy-900/15 px-4 py-3 text-sm text-navy-800 has-[:checked]:border-amber-500 has-[:checked]:bg-amber-500/10';

				const input = document.createElement('input');
				input.type = inputType;
				input.name = q.key;
				input.id = id;
				input.value = option;
				input.checked = selected.has(option);
				input.className = 'h-4 w-4 accent-amber-500';

				input.addEventListener('change', () => {
					if (q.type === 'multi') {
						const current = new Set(answers[q.key] ?? []);
						if (input.checked) current.add(option);
						else current.delete(option);
						answers[q.key] = Array.from(current);
					} else {
						answers[q.key] = option;
					}
				});

				label.appendChild(input);
				label.appendChild(document.createTextNode(option));
				optionsEl.appendChild(label);
			});
		}

		backBtn.addEventListener('click', () => {
			if (step > 0) {
				step -= 1;
				renderStep();
			}
		});

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const isLast = step === questions.length - 1;

			if (!isLast) {
				step += 1;
				renderStep();
				return;
			}

			nextBtn.disabled = true;
			nextBtn.textContent = 'Submitting…';
			errorEl.classList.add('hidden');

			try {
				const res = await fetch('/api/questionnaire', {
					method: 'POST',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({
						section,
						contactId: contactId ? Number(contactId) : null,
						answers,
					}),
				});
				if (!res.ok) throw new Error('Request failed');
				appEl.classList.add('hidden');
				doneEl.classList.remove('hidden');
			} catch {
				errorEl.textContent = 'Something went wrong submitting your answers. Please try again.';
				errorEl.classList.remove('hidden');
				nextBtn.disabled = false;
				nextBtn.textContent = 'Submit';
			}
		});

		introEl.classList.add('hidden');
		appEl.classList.remove('hidden');
		renderStep();
	</script>
</Layout>
