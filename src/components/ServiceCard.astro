---
import ServiceArt from './illustrations/ServiceArt.astro';

interface Props {
	id?: string;
	art?: 'it' | 'media' | 'management';
	eyebrow: string;
	title: string;
	description: string;
	points: string[];
}

const { id, art, eyebrow, title, description, points } = Astro.props;
---

<div id={id} class="scroll-mt-24 overflow-hidden rounded-2xl border border-navy-900/10 bg-white shadow-sm transition-shadow hover:shadow-md">
	{art && (
		<div class="flex items-center justify-center border-b border-navy-900/5 bg-gradient-to-b from-mist-100 to-mist-200/60 px-8 py-8">
			<ServiceArt name={art} class="h-28 w-auto" />
		</div>
	)}
	<div class="p-8">
	<p class="text-xs font-semibold tracking-wide text-amber-500 uppercase">{eyebrow}</p>
	<h3 class="mt-2 font-display text-xl font-semibold text-navy-950">{title}</h3>
	<p class="mt-3 text-sm leading-relaxed text-navy-700/80">{description}</p>
	<ul class="mt-5 space-y-2">
		{points.map((point) => (
			<li class="flex items-start gap-2 text-sm text-navy-800">
				<span class="mt-1 h-1.5 w-1.5 flex-none rounded-full bg-amber-500"></span>
				{point}
			</li>
		))}
	</ul>
	</div>
</div>
