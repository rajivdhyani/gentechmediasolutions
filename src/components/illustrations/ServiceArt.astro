---
interface Props {
	name: 'it' | 'media' | 'management';
	class?: string;
}

const { name, class: className = '' } = Astro.props;
---

{
	name === 'it' && (
		<svg
			viewBox="0 0 128 96"
			fill="none"
			xmlns="http://www.w3.org/2000/svg"
			class={className}
			role="img"
			aria-label="Connected servers representing managed infrastructure"
		>
			<path
				d="M64 26 40 38M64 26 88 38M64 26 64 44"
				stroke="#dfe4ed"
				stroke-width="2.5"
				stroke-linecap="round"
			/>
			<circle cx="40" cy="39" r="6" fill="#c3d2e8" />
			<circle cx="88" cy="39" r="6" fill="#c3d2e8" />
			<circle cx="64" cy="20" r="9" fill="#f5a524" />
			<path d="M60 20h8M64 16v8" stroke="#16213a" stroke-width="2" stroke-linecap="round" />

			<rect x="26" y="50" width="76" height="15" rx="4" fill="#16213a" />
			<rect x="33" y="55.5" width="22" height="4" rx="2" fill="#4c5c7f" />
			<circle cx="92" cy="57.5" r="3" fill="#f5a524" />

			<rect x="26" y="69" width="76" height="15" rx="4" fill="#2b3b60" />
			<rect x="33" y="74.5" width="14" height="4" rx="2" fill="#647394" />
			<circle cx="92" cy="76.5" r="3" fill="#c3d2e8" />

			<rect x="36" y="88" width="56" height="6" rx="3" fill="#ffffff" />
		</svg>
	)
}

{
	name === 'media' && (
		<svg
			viewBox="0 0 128 96"
			fill="none"
			xmlns="http://www.w3.org/2000/svg"
			class={className}
			role="img"
			aria-label="Layered media frames with a play control"
		>
			<rect x="22" y="26" width="62" height="44" rx="7" fill="#ffffff" />
			<rect x="31" y="19" width="62" height="44" rx="7" fill="#c3d2e8" />
			<rect x="40" y="12" width="62" height="44" rx="7" fill="#16213a" />

			<circle cx="71" cy="34" r="13" fill="#f5a524" />
			<path d="M67.5 28.5 78 34l-10.5 5.5z" fill="#16213a" />

			<rect x="30" y="76" width="4" height="10" rx="2" fill="#c3d2e8" />
			<rect x="39" y="70" width="4" height="16" rx="2" fill="#2b3b60" />
			<rect x="48" y="64" width="4" height="22" rx="2" fill="#f5a524" />
			<rect x="57" y="72" width="4" height="14" rx="2" fill="#2b3b60" />
			<rect x="66" y="66" width="4" height="20" rx="2" fill="#c3d2e8" />
			<rect x="75" y="74" width="4" height="12" rx="2" fill="#2b3b60" />
			<rect x="84" y="78" width="4" height="8" rx="2" fill="#c3d2e8" />
			<rect x="93" y="72" width="4" height="14" rx="2" fill="#2b3b60" />
		</svg>
	)
}

{
	name === 'management' && (
		<svg
			viewBox="0 0 128 96"
			fill="none"
			xmlns="http://www.w3.org/2000/svg"
			class={className}
			role="img"
			aria-label="Task board with columns tracking work in progress"
		>
			<rect x="18" y="14" width="92" height="68" rx="8" fill="#ffffff" />

			<rect x="26" y="22" width="24" height="5" rx="2.5" fill="#c3d2e8" />
			<rect x="26" y="32" width="24" height="16" rx="4" fill="#16213a" />
			<rect x="26" y="52" width="24" height="16" rx="4" fill="#2b3b60" />

			<rect x="54" y="22" width="24" height="5" rx="2.5" fill="#c3d2e8" />
			<rect x="54" y="32" width="24" height="16" rx="4" fill="#f5a524" />
			<rect x="54" y="52" width="24" height="12" rx="4" fill="#c3d2e8" />

			<rect x="82" y="22" width="24" height="5" rx="2.5" fill="#c3d2e8" />
			<rect x="82" y="32" width="24" height="16" rx="4" fill="#2b3b60" />
			<path
				d="M88 40.5 92 44.5 100 36.5"
				stroke="#eef1f6"
				stroke-width="2.5"
				stroke-linecap="round"
				stroke-linejoin="round"
			/>

			<rect x="30" y="88" width="68" height="6" rx="3" fill="#dfe4ed" />
			<rect x="30" y="88" width="40" height="6" rx="3" fill="#f5a524" />
		</svg>
	)
}
