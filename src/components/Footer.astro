---
const year = new Date().getFullYear();
---

<footer class="border-t border-navy-900/5 bg-navy-950 text-mist-100">
	<div class="mx-auto max-w-6xl px-6 py-12">
		<div class="grid gap-10 md:grid-cols-3">
			<div>
				<p class="font-display text-lg font-semibold text-white">
					Gentech <span class="text-amber-400">Media</span> Solutions
				</p>
				<p class="mt-3 max-w-xs text-sm text-mist-200/70">
					IT, media, and management support for startups and growing companies that need more than one vendor can usually offer.
				</p>
			</div>
			<div>
				<p class="text-sm font-semibold text-white">Services</p>
				<ul class="mt-3 space-y-2 text-sm text-mist-200/70">
					<li><a href="/services#it" class="hover:text-amber-400">IT Solutions</a></li>
					<li><a href="/services#media" class="hover:text-amber-400">Media Solutions</a></li>
					<li><a href="/services#management" class="hover:text-amber-400">Management Solutions</a></li>
				</ul>
			</div>
			<div>
				<p class="text-sm font-semibold text-white">Contact</p>
				<ul class="mt-3 space-y-2 text-sm text-mist-200/70">
					<li>
						<a href="mailto:hr@gentechmediasolutions.com" class="hover:text-amber-400">
							hr@gentechmediasolutions.com
						</a>
					</li>
					<li><a href="/contact" class="hover:text-amber-400">Contact form</a></li>
				</ul>
			</div>
		</div>
		<div class="mt-10 border-t border-white/10 pt-6 text-xs text-mist-200/50">
			© {year} Gentech Media Solutions. All rights reserved.
		</div>
	</div>
</footer>
